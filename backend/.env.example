FLASK_APP=app:create_app
# Used by `flask run` only. Never enable debug on a public server.
FLASK_DEBUG=1
APP_ENV=development
# demo requires a random key of at least 32 characters and explicit allowed hosts.
SECRET_KEY=
TRUSTED_HOSTS=localhost,127.0.0.1,[::1]
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=syncarch
DB_USER=syncarch
DB_PASSWORD=syncarch_dev_password
# Optional override, e.g. mysql+pymysql://user:password@host:3306/syncarch?charset=utf8mb4
# DATABASE_URL=
# Explicit `flask seed-accounts` only. JSON mapping of the five documented login IDs
# to distinct 12-128 character passwords. Supply privately; never commit real values.
# SEED_ACCOUNT_PASSWORDS=
