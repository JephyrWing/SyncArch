FLASK_APP=app:create_app
# flask run에서만 사용합니다. 공개 서버에서는 디버그 모드를 켜지 마세요.
FLASK_DEBUG=1
APP_ENV=development
# demo 환경에서는 32자 이상의 무작위 키와 명시적인 허용 호스트가 필요합니다.
SECRET_KEY=
TRUSTED_HOSTS=localhost,127.0.0.1,[::1]
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=syncarch
DB_USER=syncarch
DB_PASSWORD=syncarch_dev_password
# 개별 DB 설정 대신 연결 URL을 지정할 수 있습니다.
# DATABASE_URL=
# flask seed-accounts를 직접 실행할 때만 사용합니다. 팀원 로그인 ID 5개를 키로 하는 JSON 객체입니다.
# 값은 서로 다른 12~128자 비밀번호입니다. 실제 값은 비공개로 설정하고 Git에 커밋하지 마세요.
# SEED_ACCOUNT_PASSWORDS=

# SECRET_KEY와 다른 무작위 JWT 서명키입니다. demo에서는 32자 이상을 직접 지정해야 합니다.
JWT_SECRET_KEY=
# AT 15분, RT 세션 7일입니다. RT 회전으로 세션의 절대 만료 시각을 늘리지 않습니다.
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=604800
# 사용자 확정: 개발·배포 모두 TLS 없이 Redis Cloud에 연결합니다.
# endpoint(호스트:포트)를 포함한 전체 URL을 입력하세요. 비밀번호의 특수문자는 URL 인코딩합니다.
# 예: redis://default:<URL인코딩한비밀번호>@<호스트>:<포트>/0
REDIS_URL=
# 브라우저가 접속하는 정확한 출처입니다. demo에서는 실제 공개 HTTPS 출처를 지정합니다.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5000,http://127.0.0.1:5000
# 구글 로그인은 설정 후 true로 활성화합니다. 실제 시크릿은 개인 .env에만 넣습니다.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# 이메일 검증 코드 발송용 SMTP 설정입니다. 호스트와 발신 주소가 없으면 비활성 상태입니다.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false
