FLASK_APP=app:create_app
# flask run에서만 사용합니다. 공개 서버에서는 디버그 모드를 켜지 마세요.
FLASK_DEBUG=1
APP_ENV=development
# demo 환경에서는 32자 이상의 무작위 키와 명시적인 허용 호스트가 필요합니다.
SECRET_KEY=
TRUSTED_HOSTS=localhost,127.0.0.1,[::1]
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=syncarch
DB_USER=syncarch
DB_PASSWORD=syncarch_dev_password
# 개별 DB 설정 대신 연결 URL을 지정할 수 있습니다. 예: mysql+pymysql://user:password@host:3306/syncarch?charset=utf8mb4
# DATABASE_URL=
# flask seed-accounts를 직접 실행할 때만 사용합니다. 팀원 로그인 ID 5개를 키로 하는 JSON 객체입니다.
# 값은 서로 다른 12~128자 비밀번호입니다. 실제 값은 비공개로 설정하고 Git에 커밋하지 마세요.
# SEED_ACCOUNT_PASSWORDS=

# Redis Cloud 연결 설정입니다. 사용자 확정: 개발·배포 모두 TLS 없이 redis://로 연결합니다.
# endpoint(호스트:포트)를 포함한 전체 URL을 입력하세요. 비밀번호의 특수문자는 URL 인코딩합니다.
# 예: redis://default:<URL인코딩한비밀번호>@<호스트>:<포트>/0
# 실제 값은 팀 공용 .env로 받습니다. 이 파일이나 프론트엔드 VITE_* 변수에 넣지 마세요.
REDIS_URL=

# W03 인증 설정입니다. SECRET_KEY와 다른 무작위 JWT 서명키이며 demo에서는 32자 이상을 직접 지정합니다.
JWT_SECRET_KEY=
# AT 15분, RT 세션 7일입니다. RT 회전으로 세션의 절대 만료 시각을 늘리지 않습니다.
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=604800
# 브라우저가 접속하는 정확한 출처입니다. demo에서는 실제 공개 HTTPS 출처를 지정합니다.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5000,http://127.0.0.1:5000

# 구글 소셜 로그인용 OAuth 클라이언트 설정입니다. 클라이언트 ID는 공개값이라 팀 공용 값을 그대로 둡니다.
# 클라이언트 시크릿은 팀 공용 .env로 받고 Git에 커밋하지 마세요.
GOOGLE_CLIENT_ID=884272152569-n0nhdoeqitoh1547de5j8bvkgfgual61.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_ENABLED=true
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# [API 명세 엑셀] 선택 사항. 저장할 때마다 API 명세 엑셀을 이 폴더에 최신본으로 덮어씁니다.
# 구글 드라이브 데스크톱 동기화 폴더로 두면 팀원이 같은 파일을 봅니다. 예: API_SPEC_EXPORT_DIR=G:\내 드라이브\SyncArch
# API_SPEC_EXPORT_DIR=
# [시드 데이터] 선택 사항. scripts/seed.py용 팀원 구글 이메일을 이메일:이름 형식으로 쉼표로 잇습니다.
# SEED_TEAM_EMAILS=lead@gmail.com:팀장,dev1@gmail.com:개발1
